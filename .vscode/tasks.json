{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zangraf: iniciar site local",
      "type": "shell",
      "command": "/bin/zsh",
      "args": ["${workspaceFolder}/scripts/start-local.sh"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\iniciar.ps1"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "zangraf",
        "pattern": { "regexp": "^(.*):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4 },
        "background": { "activeOnStart": true, "beginsPattern": "Starting", "endsPattern": "Ready in" }
      }
    }
  ]
}
